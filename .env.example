DB_URL=jdbc:postgresql://localhost:5432/checkbook
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
JPA_DDL_AUTO=validate
# 외부 API 키 3개는 필수다. 비어 있으면 기동이 멈춘다(@NotBlank, 로컬 개발도 같음)
# YES24 OpenAPI(도서 식별·메인 추천)
